{
  "manifest_version": 3,
  "name": "PhoneBox video crop",
  "version": "1.0.0",
  "description": "Tells the PhoneBox agent on this computer where the playing video is, so the phone's Now playing screen shows the video alone instead of the whole browser window.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html" },
  "browser_specific_settings": {
    "gecko": { "id": "video-crop@phonebox.local", "strict_min_version": "121.0" }
  }
}
